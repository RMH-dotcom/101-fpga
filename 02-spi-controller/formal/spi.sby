# prf (prove): Checks if the .sv never "breaks". If there is no failure, even at
# infinite cycles, the HDL is valid.

# will !o_cs_n |-> !o_tx_ready and o_tx_ready |-> !o_mosi for infinite cycles? However
# we are bounding them to 20 here.

[tasks]
prf
cvr

[options]
prf: mode prove
prf: depth 20
cvr: mode cover
cvr: depth 20

[engines]
smtbmc z3

[script]
read -formal spi_master.sv # Read the RTL with formal defines enabled
prep -top spi_master # specify top module. Synthesise and prepare module for verification

[files]
../rtl/spi_master.sv
